{
  "comment": "Negative instances of contracts/choice-log.schema.json v0.1. Each case applies an RFC 6902 add/remove/replace patch to line 1 of valid.jsonl and must fail with exactly one error, at instance path 'at' (JSON pointer) and with keyword 'keyword', so it fails for its stated reason and no other.",
  "base": "valid.jsonl#1",
  "cases": [
    {"name": "unknown top-level key", "patch": [{"op": "add", "path": "/rating", "value": 5}], "at": "", "keyword": "additionalProperties"},
    {"name": "schema_version missing", "patch": [{"op": "remove", "path": "/schema_version"}], "at": "", "keyword": "required"},
    {"name": "schema_version 0.2", "patch": [{"op": "replace", "path": "/schema_version", "value": "0.2"}], "at": "/schema_version", "keyword": "const"},
    {"name": "time missing", "patch": [{"op": "remove", "path": "/time"}], "at": "", "keyword": "required"},
    {"name": "time without offset", "patch": [{"op": "replace", "path": "/time", "value": "2026-11-07T09:12:30"}], "at": "/time", "keyword": "pattern"},
    {"name": "time lower-case t", "patch": [{"op": "replace", "path": "/time", "value": "2026-11-07t09:12:30Z"}], "at": "/time", "keyword": "pattern"},
    {"name": "time with space", "patch": [{"op": "replace", "path": "/time", "value": "2026-11-07 09:12:30Z"}], "at": "/time", "keyword": "pattern"},
    {"name": "time leap second", "patch": [{"op": "replace", "path": "/time", "value": "2026-12-31T23:59:60Z"}], "at": "/time", "keyword": "pattern"},
    {"name": "time month 13", "patch": [{"op": "replace", "path": "/time", "value": "2026-13-01T00:00:00Z"}], "at": "/time", "keyword": "pattern"},
    {"name": "time as number", "patch": [{"op": "replace", "path": "/time", "value": 1762506750}], "at": "/time", "keyword": "type"},
    {"name": "verdict unknown", "patch": [{"op": "replace", "path": "/verdict", "value": "like"}], "at": "/verdict", "keyword": "enum"},
    {"name": "verdict German label", "patch": [{"op": "replace", "path": "/verdict", "value": "Favorit"}], "at": "/verdict", "keyword": "enum"},
    {"name": "verdict missing", "patch": [{"op": "remove", "path": "/verdict"}], "at": "", "keyword": "required"},
    {"name": "sample missing", "patch": [{"op": "remove", "path": "/sample"}], "at": "", "keyword": "required"},
    {"name": "sample unknown key", "patch": [{"op": "add", "path": "/sample/size", "value": 1}], "at": "/sample", "keyword": "additionalProperties"},
    {"name": "sample path missing", "patch": [{"op": "remove", "path": "/sample/path"}], "at": "/sample", "keyword": "required"},
    {"name": "path absolute posix", "patch": [{"op": "replace", "path": "/sample/path", "value": "/home/u/kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path with drive", "patch": [{"op": "replace", "path": "/sample/path", "value": "C:/Users/u/kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path with backslash", "patch": [{"op": "replace", "path": "/sample/path", "value": "Samples\\Kicks\\kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path parent segment", "patch": [{"op": "replace", "path": "/sample/path", "value": "Samples/../../kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path starts with parent", "patch": [{"op": "replace", "path": "/sample/path", "value": "../kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path empty segment", "patch": [{"op": "replace", "path": "/sample/path", "value": "Samples//kick.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path not a wav", "patch": [{"op": "replace", "path": "/sample/path", "value": "Samples/Kicks/kick.json"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path control character", "patch": [{"op": "replace", "path": "/sample/path", "value": "Samples/ki\nck.wav"}], "at": "/sample/path", "keyword": "pattern"},
    {"name": "path only extension", "patch": [{"op": "replace", "path": "/sample/path", "value": ".wav"}], "at": "/sample/path", "keyword": "minLength"},
    {"name": "sha256 upper case", "patch": [{"op": "replace", "path": "/sample/sha256", "value": "3F5A0C9E1B2D4F6A8C0E2A4B6D8F0A1C3E5A7C9E1B3D5F7A9C1E3A5B7D9F1A2C"}], "at": "/sample/sha256", "keyword": "pattern"},
    {"name": "sha256 63 digits", "patch": [{"op": "replace", "path": "/sample/sha256", "value": "3f5a0c9e1b2d4f6a8c0e2a4b6d8f0a1c3e5a7c9e1b3d5f7a9c1e3a5b7d9f1a2"}], "at": "/sample/sha256", "keyword": "pattern"},
    {"name": "sha256 null from the gui", "patch": [{"op": "replace", "path": "/sample/sha256", "value": null}], "at": "/sample/sha256", "keyword": "type"},
    {"name": "sha256 missing", "patch": [{"op": "remove", "path": "/sample/sha256"}], "at": "/sample", "keyword": "required"},
    {"name": "category missing", "patch": [{"op": "remove", "path": "/sample/category"}], "at": "/sample", "keyword": "required"},
    {"name": "category upper case", "patch": [{"op": "replace", "path": "/sample/category", "value": "Kick"}], "at": "/sample/category", "keyword": "pattern"},
    {"name": "category empty", "patch": [{"op": "replace", "path": "/sample/category", "value": ""}], "at": "/sample/category", "keyword": "pattern"},
    {"name": "sidecar missing", "patch": [{"op": "remove", "path": "/sidecar"}], "at": "", "keyword": "required"},
    {"name": "sidecar as string", "patch": [{"op": "replace", "path": "/sidecar", "value": "kick.json"}], "at": "/sidecar", "keyword": "type"},
    {"name": "sidecar unknown key", "patch": [{"op": "add", "path": "/sidecar/parameters", "value": {}}], "at": "/sidecar", "keyword": "additionalProperties"},
    {"name": "sidecar seed missing", "patch": [{"op": "remove", "path": "/sidecar/seed"}], "at": "/sidecar", "keyword": "required"},
    {"name": "sidecar seed negative", "patch": [{"op": "replace", "path": "/sidecar/seed", "value": -1}], "at": "/sidecar/seed", "keyword": "minimum"},
    {"name": "sidecar seed float", "patch": [{"op": "replace", "path": "/sidecar/seed", "value": 5.5}], "at": "/sidecar/seed", "keyword": "type"},
    {"name": "sidecar preset number", "patch": [{"op": "replace", "path": "/sidecar/preset", "value": 3}], "at": "/sidecar/preset", "keyword": "type"},
    {"name": "sidecar engine version missing", "patch": [{"op": "remove", "path": "/sidecar/engine/version"}], "at": "/sidecar/engine", "keyword": "required"},
    {"name": "sidecar engine name empty", "patch": [{"op": "replace", "path": "/sidecar/engine/name", "value": ""}], "at": "/sidecar/engine/name", "keyword": "minLength"},
    {"name": "note empty", "patch": [{"op": "add", "path": "/note", "value": ""}], "at": "/note", "keyword": "minLength"},
    {"name": "note null", "patch": [{"op": "add", "path": "/note", "value": null}], "at": "/note", "keyword": "type"},
    {"name": "note too long", "patch": [{"op": "add", "path": "/note", "value": {"$repeat": "x", "times": 2001}}], "at": "/note", "keyword": "maxLength"},
    {"name": "source missing", "patch": [{"op": "remove", "path": "/source"}], "at": "", "keyword": "required"},
    {"name": "source unknown", "patch": [{"op": "replace", "path": "/source", "value": "chat"}], "at": "/source", "keyword": "enum"},
    {"name": "test on a gui entry", "patch": [{"op": "add", "path": "/test", "value": {"id": "LT1", "item": "P1"}}], "at": "", "keyword": "not"},
    {"name": "listening test without test", "patch": [{"op": "replace", "path": "/source", "value": "listening-test"}], "at": "", "keyword": "required"},
    {"name": "test id with space", "patch": [{"op": "replace", "path": "/source", "value": "listening-test"}, {"op": "add", "path": "/test", "value": {"id": "LT 1", "item": "P1"}}], "at": "/test/id", "keyword": "pattern"},
    {"name": "test item missing", "patch": [{"op": "replace", "path": "/source", "value": "listening-test"}, {"op": "add", "path": "/test", "value": {"id": "LT1"}}], "at": "/test", "keyword": "required"},
    {"name": "compared_with absolute path", "patch": [{"op": "replace", "path": "/source", "value": "listening-test"}, {"op": "add", "path": "/test", "value": {"id": "LT1", "item": "P1", "compared_with": {"path": "/lt1/P1_A.wav", "sha256": null}}}], "at": "/test/compared_with/path", "keyword": "pattern"},
    {"name": "compared_with sha256 missing", "patch": [{"op": "replace", "path": "/source", "value": "listening-test"}, {"op": "add", "path": "/test", "value": {"id": "LT1", "item": "P1", "compared_with": {"path": "lt1/P1_A.wav"}}}], "at": "/test/compared_with", "keyword": "required"},
    {"name": "entry is an array", "patch": [{"op": "replace", "path": "", "value": []}], "at": "", "keyword": "type"}
  ]
}
