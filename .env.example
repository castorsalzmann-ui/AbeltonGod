# Copy to .env (git-ignored) and fill in only what you use. Never commit .env.

# --- Claude (Phase 04b, not needed before) ---
# Leave empty to use your Claude subscription through the Claude Agent SDK (D-008).
# Set only if you switch to API billing: create a key at https://console.anthropic.com
# Note: if this is set, Claude Code also bills to the API instead of your subscription.
ANTHROPIC_API_KEY=

# --- Ableton bridge (Phase 02) ---
# AbletonOSC defaults; change only if you changed them in the remote script.
ABLETON_OSC_HOST=127.0.0.1
ABLETON_OSC_SEND_PORT=11000
ABLETON_OSC_RECEIVE_PORT=11001

# --- Sample library (Phase 03) ---
# Root folder for generated samples, e.g. C:\Users\<you>\Music\AbeltonGod
SAMPLE_LIBRARY_ROOT=
