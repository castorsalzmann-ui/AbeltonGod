# Copy to .env (git-ignored) and fill in only what you use. Never commit .env.

# --- Claude (Phase 04b, not needed before) ---
# Auth switch (D-008, D-014): "subscription" (default: your Claude login via the Agent SDK)
# or "api_key" (uses ANTHROPIC_API_KEY below).
ABELTONGOD_CLAUDE_AUTH=subscription
# Model for the copilot (default claude-opus-5-5, D-014).
ABELTONGOD_CLAUDE_MODEL=
# Only for ABELTONGOD_CLAUDE_AUTH=api_key: create a key at https://console.anthropic.com
# In subscription mode the copilot refuses to start while this (or ANTHROPIC_AUTH_TOKEN) is
# set here or in the Windows environment: the SDK would silently bill the key instead.
# Note: if this is set, Claude Code also bills to the API instead of your subscription.
ANTHROPIC_API_KEY=

# --- Ableton bridge (Phase 02) ---
# AbletonOSC defaults; change only if you changed them in the remote script.
ABLETON_OSC_HOST=127.0.0.1
ABLETON_OSC_SEND_PORT=11000
ABLETON_OSC_RECEIVE_PORT=11001

# --- Sample library (Phase 03) ---
# Root folder for generated samples, e.g. C:\Users\<you>\Music\AbeltonGod
SAMPLE_LIBRARY_ROOT=
