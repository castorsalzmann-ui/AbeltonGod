{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/waste_watch.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
