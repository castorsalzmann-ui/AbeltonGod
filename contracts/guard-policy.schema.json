{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castorsalzmann-ui/AbeltonGod/contracts/guard-policy.schema.json",
  "title": "Agent Resource Guard policy",
  "description": "Limits for every Claude-backed request of the product (not for development sessions in Claude Code). See docs/DECISIONS.md D-011.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "global", "profiles"],
  "properties": {
    "schema_version": { "const": "1" },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_budget_usd", "daily_budget_usd", "max_concurrent_requests"],
      "properties": {
        "session_budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "daily_budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_concurrent_requests": { "type": "integer", "minimum": 1, "maximum": 8 },
        "cost_basis_note": { "type": "string" }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_tokens", "max_model_calls", "max_tool_calls", "max_budget_usd",
        "timeout_s", "max_identical_tool_calls", "max_files_written", "max_live_writes",
        "warn_at_fraction"
      ],
      "properties": {
        "description": { "type": "string" },
        "max_output_tokens": { "type": "integer", "minimum": 64, "maximum": 32000 },
        "max_model_calls": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 200 },
        "max_budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "timeout_s": { "type": "number", "minimum": 5, "maximum": 3600 },
        "max_identical_tool_calls": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Same tool + same arguments within one request before it counts as a loop." },
        "max_files_written": { "type": "integer", "minimum": 0, "maximum": 500 },
        "max_live_writes": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Changes to the Ableton set per request. Each still needs its approval level." },
        "warn_at_fraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      }
    }
  }
}
